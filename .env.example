# SIP Honeypot Configuration
# Copy this to .env and modify as needed

# Database
MYSQL_ROOT_PASSWORD=your_root_password_here
DB_PASSWORD=your_honeypot_db_password_here

# Admin account for web UI
ADMIN_USER=admin
ADMIN_PASS=change_this_password

# Auto-block threshold (number of hits before auto-blocking)
AUTO_BLOCK_THRESHOLD=3

# Server name for SSL certificate and Apache
# Use your domain name or IP address
SERVER_NAME=honeypot.example.com

# Optional: Custom ports (if you need to change defaults)
# SIP_PORT=5060
# HTTP_PORT=8080
# API_PORT=8081

# SSL Certificates
# Place your certificates in ./apache/ssl/ directory:
#   - server.crt (certificate)
#   - server.key (private key)
# If not provided, a self-signed certificate will be generated automatically
